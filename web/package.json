{
  "name": "amd-screening-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/prepare-assets.mjs && next dev",
    "build": "node scripts/prepare-assets.mjs && node scripts/fetch-model-card.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/db-seed.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "next": "16.4.3",
    "onnxruntime-web": "^1.31.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.4"
}
